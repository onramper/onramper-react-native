# Inclusion is driven by the `files` allowlist in package.json (which lists the
# exact ios/*.swift sources, so ios/Tests is excluded by construction). The iOS
# SDK itself is not in the package: the podspec pulls it from onramper-ios
# through Swift Package Manager. This file only trims stray dev artifacts that
# could otherwise slip in.

# Top-level hidden directories
/.*/

# Tarballs generated by `npm pack`
/*.tgz

# Tests and mocks
__mocks__
__tests__
*.test.ts
*.test.tsx

# Dev/CI/docs/example
/babel.config.js
/example/
/docs/
/.github/

# Defensive: never ship native test sources
ios/Tests/
